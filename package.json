{
  "name": "jupyter-image-scaler",
  "displayName": "Jupyter Image Scaler · 附件图片缩放",
  "description": "Notebook Markdown 附件图片悬浮缩放、自定义比例与尺寸快捷档位。",
  "version": "1.2.0",
  "publisher": "local-notebook-tools",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Notebooks"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onNotebook:jupyter-notebook",
    "onRenderer:local-notebook-tools.jupyter-image-scaler-renderer"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "scripts": {
    "build": "node build.cjs",
    "test": "node --test test/unit.cjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links"
  },
  "contributes": {
    "commands": [
      {
        "command": "jupyterImageScaler.choose",
        "title": "附件图片缩放：选择档位",
        "category": "Notebook",
        "icon": "$(zoom-in)"
      },
      {
        "command": "jupyterImageScaler.scale25",
        "title": "附件图片缩放：25%",
        "category": "Notebook"
      },
      {
        "command": "jupyterImageScaler.scale50",
        "title": "附件图片缩放：50%",
        "category": "Notebook"
      },
      {
        "command": "jupyterImageScaler.scale75",
        "title": "附件图片缩放：75%",
        "category": "Notebook"
      },
      {
        "command": "jupyterImageScaler.scale100",
        "title": "附件图片缩放：100%（恢复）",
        "category": "Notebook"
      },
      {
        "command": "jupyterImageScaler.applyPreset",
        "title": "附件图片缩放：应用快捷档位",
        "category": "Notebook"
      },
      {
        "command": "jupyterImageScaler.settings",
        "title": "附件图片缩放：设置快捷档位",
        "category": "Notebook",
        "icon": "$(gear)"
      }
    ],
    "keybindings": [
      {
        "command": "jupyterImageScaler.choose",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "notebookEditorFocused && notebookType == 'jupyter-notebook' && notebookCellType == 'markup'"
      }
    ],
    "menus": {
      "notebook/cell/title": [
        {
          "command": "jupyterImageScaler.choose",
          "when": "notebookType == 'jupyter-notebook' && notebookCellType == 'markup'",
          "group": "inline@20"
        }
      ]
    },
    "notebookRenderer": [
      {
        "id": "local-notebook-tools.jupyter-image-scaler-renderer",
        "displayName": "Notebook attachment image scale",
        "entrypoint": {
          "extends": "vscode.markdown-it-renderer",
          "path": "./dist/renderer.js"
        },
        "requiresMessaging": "always"
      }
    ],
    "configuration": {
      "title": "Jupyter Image Scaler",
      "properties": {
        "jupyterImageScaler.presets": {
          "type": "array",
          "default": [
            {
              "percent": 25
            },
            {
              "percent": 50
            },
            {
              "percent": 75
            },
            {
              "percent": 100
            }
          ],
          "maxItems": 12,
          "description": "图片旁及编辑状态的快捷档位。百分比相对于默认显示宽度；像素尺寸可只填宽度以保持比例。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "percent": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "oneOf": [
              {
                "required": [
                  "percent"
                ]
              },
              {
                "required": [
                  "width"
                ]
              }
            ]
          }
        },
        "jupyterImageScaler.toolbarStyle": {
          "type": "string",
          "enum": [
            "overlay",
            "outside"
          ],
          "enumDescriptions": [
            "紧凑菜单显示在图片左上角，悬浮时出现。",
            "菜单自动选择图片左侧、右侧或下方的空位，不遮挡图片。"
          ],
          "default": "overlay",
          "description": "图片快捷档位菜单的显示样式，可从图片齿轮菜单切换。"
        }
      }
    }
  },
  "dependencies": {
    "image-size": "2.1.0",
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@vscode/vsce": "4.1.1",
    "playwright": "1.65.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CurtisYan/jupyter-image-scaler.git"
  }
}
